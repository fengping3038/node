# 复制本文件为 .env 并修改，然后运行：docker compose up -d --build
# 本地开发/自建服务器用；免费平台（Zeabur/Railway）则直接在平台环境变量里填这些值

# MySQL 容器配置
MYSQL_ROOT_PASSWORD=please-change-to-a-strong-password
MYSQL_DATABASE=nuxt_app
MYSQL_USER=nuxt_app
MYSQL_PASSWORD=please-change-to-another-password

# JWT 密钥（务必改成足够长的随机字符串，例如：openssl rand -hex 32 的输出）
JWT_SECRET=please-change-to-a-long-random-string-at-least-32-chars
